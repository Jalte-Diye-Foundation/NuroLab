<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug/emulator: allow cleartext HTTP/WS to local Cereqon backend (e.g. 10.0.2.2). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
