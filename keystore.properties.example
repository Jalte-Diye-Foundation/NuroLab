# Copy to keystore.properties (gitignored) and fill in values.
# Generate upload keystore:
#   keytool -genkey -v -keystore release-keystore.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias cereqon-release -storepass YOUR_STORE_PASSWORD \
#     -keypass YOUR_KEY_PASSWORD -dname "CN=Cereqon, OU=Engineering, O=Jalte Diye Foundation, C=US"
#
# Play Console: enroll in Play App Signing and upload this key as the upload key.

storeFile=release-keystore.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=cereqon-release
keyPassword=YOUR_KEY_PASSWORD
